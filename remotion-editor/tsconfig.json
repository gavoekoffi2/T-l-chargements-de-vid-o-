{
  "compilerOptions": {
    "lib": ["dom", "es2022"],
    "module": "es2022",
    "target": "es2022",
    "strict": true,
    "outDir": "dist",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "react",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "remotion.config.ts"]
}
